<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit Profile | MYBLOGSPACE</title>
  <link rel="stylesheet" href="/edit-profile.css" />
</head>

<body>

  <!-- Apply saved theme -->
  <script>
    if (localStorage.getItem("siteTheme") === "light") {
      document.body.classList.add("light-mode");
    }
  </script>

  <!-- SIDEBAR -->
  <div class="sidebar">

    <h2>MYBLOGSPACE</h2>

    <nav>
      <a href="/home">Home</a>
      <a href="/notification">Notifications</a>
      <a href="/messages">Messages</a>
      <a href="/profil" class="active">Profile</a>
      <a href="/login">Logout</a>
    </nav>

    <a href="/create-blog">
      <button class="post-btn">Create Blog</button>
    </a>

  </div>


  <!-- MAIN CONTENT -->
  <div class="main-content">

    <div class="page-header">
      <h2>Edit Profile</h2>
      <p>Update your profile information</p>
    </div>

    <form
      action="/update-profile"
      method="POST"
      enctype="multipart/form-data"
      class="edit-form"
    >

      <!-- FULL NAME -->
      <div class="form-group">

        <label for="fullname">Full Name</label>

        <input
          type="text"
          id="fullname"
          name="fullname"
          value="<%= user.fullname %>"
          required
        >

      </div>


      <!-- BIO -->
      <div class="form-group">

        <label for="bio">Bio</label>

        <textarea
          id="bio"
          name="bio"
          rows="4"
          placeholder="Tell something about yourself..."
        ><%= user.bio || '' %></textarea>

      </div>


      <!-- PROFILE PICTURE -->
      <div class="form-group">

        <label for="profilePic">Profile Picture</label>

        <input
          type="file"
          id="profilePic"
          name="profilePic"
          accept="image/*"
        >

        <% if (user.profilePicPath) { %>

          <img
            src="<%= user.profilePicPath || 'profile-pic.jpg' %>"
            alt="Profile Picture"
            class="profile-pic"
          >

        <% } %>

      </div>


      <!-- SAVE -->
      <button type="submit" class="save-btn">
        Save Changes
      </button>

    </form>

  </div>

</body>
</html>