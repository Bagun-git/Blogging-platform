<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>@<%= user.fullname %> | MYBLOGSPACE</title>
  <link rel="stylesheet" href="/user-profile.css" />
</head>

<body>

  <!-- Apply saved theme -->
  <script>
    if (localStorage.getItem("siteTheme") === "light") {
      document.body.classList.add("light-mode");
    }
  </script>


  <!-- SIDEBAR -->
  <div class="sidebar">

    <h2>MYBLOGSPACE</h2>

    <nav>
      <a href="/home">Home</a>
      <a href="/notification">Notifications</a>
      <a href="/messages">Messages</a>
      <a href="/profil">Profile</a>
      <a href="/login">Logout</a>
    </nav>

    <a href="/create-blog">
      <button class="post-btn">Create Blog</button>
    </a>

  </div>


  <!-- MAIN -->
  <div class="main">

    <!-- PROFILE -->
    <div class="profile-section">

      <img
        src="<%= user.profilePic || '/images/default-pfp-23.jpg' %>"
        alt="Profile Picture"
        class="profile-pic"
      />

      <div class="profile-info">

        <h2><%= user.fullname %></h2>

        <p class="username">
          @<%= user.fullname.replace(/\s/g, '') %>
        </p>

        <p class="bio">
          <%= user.bio || 'No bio yet.' %>
        </p>

        <p class="follow-stats">
          <strong><%= user.followers.length %></strong> Followers
          <span>|</span>
          <strong><%= user.following.length %></strong> Following
        </p>

        <% if (!currentUserId.equals(user._id)) { %>

          <button
            class="message-btn"
            onclick="startMessage('<%= user._id %>')"
          >
            Message
          </button>

        <% } %>

      </div>

    </div>


    <!-- POSTS -->
    <div class="posts">

      <h3>
        <%= user.fullname %>'s Posts
      </h3>

      <% if (userBlogs.length === 0) { %>

        <p class="no-posts">No posts yet.</p>

      <% } else { %>

        <% userBlogs.forEach(blog => { %>

          <div class="post">

            <h4>
              <%= blog.title %>
            </h4>

            <p>
              <%= blog.content.length > 200
                ? blog.content.substring(0, 200) + '...'
                : blog.content
              %>

              <% if (blog.content.length > 200) { %>
                <a href="/blog/<%= blog._id %>">
                  Read more
                </a>
              <% } %>
            </p>

            <span class="time">
              <%= blog.createdAt.toDateString() %>
            </span>

          </div>

        <% }) %>

      <% } %>

    </div>

  </div>


  <script>
    function startMessage(targetUserId) {
      window.location.href = `/messages?to=${targetUserId}`;
    }
  </script>

</body>
</html>